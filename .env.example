# Môi trường: development | test | production
NODE_ENV=development

# Cổng chạy server
PORT=3000

# Bí mật ký JWT — PHẢI đổi khi deploy lên production
JWT_SECRET=thay-bang-chuoi-bi-mat-dai-va-ngau-nhien

# Thời hạn token
JWT_EXPIRES_IN=15m

# ── Cơ sở dữ liệu ──────────────────────────────────────────────
# DB_DRIVER=sqlite   → node:sqlite: chạy/dev nhanh, không cần cài DB.
#                      TEST luôn ép sqlite ":memory:" (xem vitest.config.ts).
# DB_DRIVER=postgres → chạy thật, cần DATABASE_URL trỏ tới PostgreSQL.
DB_DRIVER=sqlite

# sqlite: đường dẫn file db (":memory:" = chỉ nằm trong RAM, mất khi tắt)
DB_FILE=dev.sqlite

# postgres: chuỗi kết nối (chỉ dùng khi DB_DRIVER=postgres)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/express_app
