# Môi trường: development | test | production
NODE_ENV=development

# Cổng chạy server
PORT=3000

# Bí mật ký JWT — PHẢI đổi khi deploy lên production
JWT_SECRET=thay-bang-chuoi-bi-mat-dai-va-ngau-nhien

# Thời hạn token
JWT_EXPIRES_IN=15m

# ── Cơ sở dữ liệu ──────────────────────────────────────────────
# MẶC ĐỊNH (DB_DRIVER=supabase): `npm run dev` chạy trên Supabase (PostgreSQL).
#   `npm run dev -- --local` (hoặc `npm run dev:local`) override sang SQLite — không cần DB server.
# DB_DRIVER=sqlite    → node:sqlite: chạy/dev nhanh, không cần cài DB.
#                       TEST luôn ép sqlite ":memory:" (xem vitest.config.ts).
DB_DRIVER=supabase

# sqlite (chỉ dùng với --local): đường dẫn file db (":memory:" = chỉ nằm trong RAM, mất khi tắt)
DB_FILE=dev.sqlite

# ── Supabase (chỉ dùng khi DB_DRIVER=supabase) ──────────────────
# Lấy từ Supabase Dashboard → Project → Settings → API.
# SUPABASE_URL: vd https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY: service_role key (bỏ qua RLS) — dùng cho phía server/quản trị.
# KHÔNG để key này vào code chạy trên client.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
#
# DATABASE_URL (tùy chọn): connection string Postgres của Supabase — nếu đặt, app TỰ TẠO BẢNG
# (users/notes/tags/note_tags) lúc khởi động qua `pg` (như driver cũ). Nếu không đặt, bạn phải
# tạo bảng trước bằng supabase/schema.sql (SQL Editor) rồi app mới chạy được.
# DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@db.<project-ref>.supabase.co:5432/postgres
#
# NOTE: nếu DATABASE_URL không có SSL ổn định, code sẽ dùng rejectUnauthorized:false
#       (chấp nhận khi dev; production nên xác thực CA đầy đủ).
