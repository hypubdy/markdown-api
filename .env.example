# Môi trường: development | test | production
NODE_ENV=development

# Cổng chạy server
PORT=3000

# Bí mật ký JWT — PHẢI đổi khi deploy lên production
JWT_SECRET=thay-bang-chuoi-bi-mat-dai-va-ngau-nhien

# Thời hạn token
JWT_EXPIRES_IN=15m

# ── Cơ sở dữ liệu ──────────────────────────────────────────────
# Node local/test dùng SQLite. Production Worker dùng D1 qua binding trong wrangler.jsonc.
#   `npm run dev` / `npm run dev:local` → SQLite local.
#   `npm run dev:worker` → Cloudflare Worker + D1 local.
DB_DRIVER=sqlite

# sqlite (chỉ dùng với --local): đường dẫn file db (":memory:" = chỉ nằm trong RAM, mất khi tắt)
DB_FILE=dev.sqlite

# Cloudflare D1 production được cấu hình bằng binding DB trong wrangler.jsonc.
# Tạo database bằng: npx wrangler d1 create markdown-api
# Sau đó điền database_id và chạy migration:
#   npx wrangler d1 migrations apply markdown-api --local

# Authentication trên Node local/test: local (JWT noi bo) | clerk.
# Cloudflare Worker production bắt buộc dùng clerk.
AUTH_PROVIDER=local
# Lay tai Clerk Dashboard -> API Keys. Bat buoc khi AUTH_PROVIDER=clerk.
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# ── Logging ─────────────────────────────────────────────────────
# requestLogger log mọi request + mọi query DB (xem src/utils/logger.ts).
# Mặc định khi KHÔNG đặt gì: dev = debug + in query; test = warn (im lặng); prod = info, JSON.
#
# Mức log: debug | info | warn | error | silent
# LOG_LEVEL=debug
# In 1 dòng cho mỗi query DB (kèm thời gian) — bật/tắt riêng, không phụ thuộc LOG_LEVEL.
# LOG_QUERIES=true
# In kèm tham số của query (password/token tự động bị che). Mặc định false.
# LOG_QUERY_ARGS=false
# Query/request vượt ngưỡng (ms) sẽ bị nâng lên mức WARN.
# SLOW_QUERY_MS=50
# SLOW_REQUEST_MS=500
# Log dạng JSON 1 dòng (tiện đẩy vào hệ thống log). Mặc định true khi NODE_ENV=production.
# LOG_JSON=false
# Tô màu log khi ghi ra terminal. Mặc định true nếu stdout là TTY.
# LOG_COLOR=true
