{
  "name": "express-ts-app",
  "version": "1.0.0",
  "description": "Dự án Express (TypeScript) chia tách theo route / middleware / action",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:local": "node scripts/dev.mjs --local",
    "dev:worker": "wrangler dev",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && esbuild src/server.ts src/seed.ts --bundle --platform=node --format=esm --packages=external --outdir=dist --sourcemap",
    "build:worker": "wrangler deploy --dry-run --outdir dist-worker",
    "deploy": "wrangler deploy",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:file": "TEST_DB_FILE=test.sqlite vitest run",
    "test:clerk": "vitest run --config vitest.clerk.config.ts",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/seed.ts",
    "seed:reset": "tsx src/seed.ts --reset"
  },
  "dependencies": {
    "@hono/clerk-auth": "^3.1.1",
    "@hono/node-server": "^2.1.1",
    "@hono/swagger-ui": "^0.6.1",
    "@supabase/postgrest-js": "^2.116.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "hono": "^4.13.7",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.130.0"
  }
}
