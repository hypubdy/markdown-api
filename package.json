{
  "name": "express-ts-app",
  "version": "1.0.0",
  "description": "Dự án Express (TypeScript) chia tách theo route / middleware / action",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:local": "node scripts/dev.mjs --local",
    "build": "rm -rf dist && esbuild src/server.ts src/seed.ts --bundle --platform=node --format=esm --packages=external --outdir=dist --sourcemap",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:file": "TEST_DB_FILE=test.sqlite vitest run",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/seed.ts",
    "seed:reset": "tsx src/seed.ts --reset"
  },
  "dependencies": {
    "@supabase/postgrest-js": "^2.116.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}
